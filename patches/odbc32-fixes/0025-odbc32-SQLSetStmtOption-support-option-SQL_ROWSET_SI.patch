From 05fabcf0a671f1aece38ed5b6886ffd3c3e6b0c8 Mon Sep 17 00:00:00 2001
From: Alistair Leslie-Hughes <leslie_alistair@hotmail.com>
Date: Tue, 22 Sep 2026 12:35:37 +1000
Subject: [PATCH 1/2] odbc32: SQLSetStmtOption support option SQL_ROWSET_SIZE

---
 dlls/odbc32/proxyodbc.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/dlls/odbc32/proxyodbc.c b/dlls/odbc32/proxyodbc.c
index 5db4b4a171d..6e06abbb514 100644
--- a/dlls/odbc32/proxyodbc.c
+++ b/dlls/odbc32/proxyodbc.c
@@ -4560,6 +4560,7 @@ static SQLRETURN set_stmt_option_win32( struct statement *stmt, SQLUSMALLINT opt
         {
             case SQL_QUERY_TIMEOUT:
             case SQL_MAX_LENGTH:
+            case SQL_ROWSET_SIZE:
                 return stmt->hdr.win32_funcs->SQLSetStmtAttrW( stmt->hdr.win32_handle, option, (SQLPOINTER)value, 0 );
             default:
                 FIXME("Unsupported option %d.\n", option);
