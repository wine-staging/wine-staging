From f50c44f6b9165692fbac8daabfb45eca425b2367 Mon Sep 17 00:00:00 2001
From: Alistair Leslie-Hughes <leslie_alistair@hotmail.com>
Date: Fri, 27 Nov 2026 13:49:07 +1100
Subject: [PATCH] winex11: Assign wintab orTwist value

---
 dlls/winex11.drv/wintab.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/dlls/winex11.drv/wintab.c b/dlls/winex11.drv/wintab.c
index 9765c3ae025..69105801d1a 100644
--- a/dlls/winex11.drv/wintab.c
+++ b/dlls/winex11.drv/wintab.c
@@ -908,6 +908,7 @@ static BOOL motion_event( HWND hwnd, XEvent *event )
     {
         FIXME("Negative orAltitude detected\n");
     }
+    gMsgPacket.pkOrientation.orTwist = (motion->axis_data[5] * 2 - 900) % 3600;
     gMsgPacket.pkNormalPressure = motion->axis_data[2];
     gMsgPacket.pkButtons = get_button_state(curnum);
     gMsgPacket.pkChanged = get_changed_state(&gMsgPacket);
@@ -942,6 +943,7 @@ static BOOL button_event( HWND hwnd, XEvent *event )
         gMsgPacket.pkOrientation.orAltitude = ((1000 - 15 * max(abs(button->axis_data[3]),
                                                                 abs(button->axis_data[4])))
                                                * (gMsgPacket.pkStatus & TPS_INVERT?-1:1));
+        gMsgPacket.pkOrientation.orTwist = (button->axis_data[5] * 2 - 900) % 3600;
         gMsgPacket.pkNormalPressure = button->axis_data[2];
     } else {
         gMsgPacket.pkX = last_packet.pkX;
@@ -1001,6 +1003,7 @@ static BOOL proximity_event( HWND hwnd, XEvent *event )
     {
         FIXME("Negative orAltitude detected\n");
     }
+    gMsgPacket.pkOrientation.orTwist = (proximity->axis_data[5] * 2 - 900) % 3600;
     gMsgPacket.pkNormalPressure = proximity->axis_data[2];
     gMsgPacket.pkButtons = get_button_state(curnum);
 
-- 
2.53.0

