From f23f5f9814175f8a528075ea6d557dab47ddd46d Mon Sep 17 00:00:00 2001
From: Ralf Habacker <ralf.habacker@freenet.de>
Date: Thu, 20 Aug 2026 13:20:01 +0200
Subject: [PATCH] afunix: add test for WSAioctl(SIO_AF_UNIX_GETPEERPID)

This Inofficial test was added so that a possible implementation
for https://bugs.winehq.org/show_bug.cgi?id=60201 can be tested.
---
 dlls/ws2_32/tests/sock.c | 5 +++++
 include/winsock2.h       | 2 ++
 2 files changed, 7 insertions(+)

diff --git a/dlls/ws2_32/tests/sock.c b/dlls/ws2_32/tests/sock.c
index 3cf83c04ef7..304ce0b70e1 100644
--- a/dlls/ws2_32/tests/sock.c
+++ b/dlls/ws2_32/tests/sock.c
@@ -14930,6 +14930,8 @@ static void test_afunix(void)
     ULONG zero = 0;
     ULONG one = 1;
     int ret;
+    DWORD pid;
+    DWORD bytesReturned;
 
     /* Test connection and send/recv */
     listener = socket(AF_UNIX, SOCK_STREAM, 0);
@@ -15023,6 +15025,9 @@ static void test_afunix(void)
     ok(ret == sizeof(serverBuf), "Incorrect return value from recvfrom: %d\n", ret);
     ok(!memcmp(serverBuf, clientBuf, sizeof(clientBuf)), "Data mismatch over Unix socket\n");
 
+    ret = WSAIoctl(client,  SIO_AF_UNIX_GETPEERPID, NULL, 0, &pid, sizeof(pid), &bytesReturned, NULL, NULL);
+    ok(!ret, "failed to get WSAioctl, error %u\n", WSAGetLastError());
+
     closesocket(listener);
     closesocket(client);
     closesocket(server);
diff --git a/include/winsock2.h b/include/winsock2.h
index 23e2aa5c0f0..18f0740fdca 100644
--- a/include/winsock2.h
+++ b/include/winsock2.h
@@ -378,6 +378,7 @@ extern "C" {
 #define WS_SIO_ADDRESS_LIST_CHANGE            _WSAIO(WS_IOC_WS2,23)
 #define WS_SIO_QUERY_TARGET_PNP_HANDLE        _WSAIOR(WS_IOC_WS2,24)
 #define WS_SIO_GET_INTERFACE_LIST             WS__IOR('t', 127, ULONG)
+#define WS_SIO_AF_UNIX_GETPEERPID             _WSAIOR(IOC_VENDOR, 256)
 #else /* USE_WS_PREFIX */
 #undef IOC_VOID
 #undef IOC_IN
@@ -426,6 +427,7 @@ extern "C" {
 #define SIO_ADDRESS_LIST_CHANGE    _WSAIO(IOC_WS2,23)
 #define SIO_QUERY_TARGET_PNP_HANDLE _WSAIOR(IOC_WS2,24)
 #define SIO_GET_INTERFACE_LIST     _IOR ('t', 127, ULONG)
+#define SIO_AF_UNIX_GETPEERPID     _WSAIOR(IOC_VENDOR, 256)
 #endif /* USE_WS_PREFIX */
 
 #ifndef USE_WS_PREFIX
-- 
2.53.0

