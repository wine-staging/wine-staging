From 564fc382efd11b18d3ffa12aa77e1d1f692fefbc Mon Sep 17 00:00:00 2001
From: Alistair Leslie-Hughes <leslie_alistair@hotmail.com>
Date: Fri, 9 Oct 2026 17:44:01 +1100
Subject: [PATCH] Updated vkd3d to fed0c3418f815b0bc07533f6fc6f4aa06e8712c3.

---
 libs/vkd3d/include/private/vkd3d_version.h |  2 +-
 libs/vkd3d/libs/vkd3d-shader/msl.c         | 34 +++++++++++++++-------
 2 files changed, 24 insertions(+), 12 deletions(-)

diff --git a/libs/vkd3d/include/private/vkd3d_version.h b/libs/vkd3d/include/private/vkd3d_version.h
index 143b7b21c97..ab78bc74768 100644
--- a/libs/vkd3d/include/private/vkd3d_version.h
+++ b/libs/vkd3d/include/private/vkd3d_version.h
@@ -1 +1 @@
-#define VKD3D_VCS_ID " (git a9d1f263)"
+#define VKD3D_VCS_ID " (git fed0c341)"
diff --git a/libs/vkd3d/libs/vkd3d-shader/msl.c b/libs/vkd3d/libs/vkd3d-shader/msl.c
index c358729547a..6f52574ee70 100644
--- a/libs/vkd3d/libs/vkd3d-shader/msl.c
+++ b/libs/vkd3d/libs/vkd3d-shader/msl.c
@@ -1575,17 +1575,6 @@ static void msl_handle_instruction(struct msl_generator *gen, const struct vsir_
         case VSIR_OP_IF:
             msl_if(gen, ins);
             break;
-        case VSIR_OP_IREM:
-        case VSIR_OP_UREM:
-            msl_binop(gen, ins, "%");
-            break;
-        case VSIR_OP_ISHL:
-            msl_binop(gen, ins, "<<");
-            break;
-        case VSIR_OP_ISHR:
-        case VSIR_OP_USHR:
-            msl_binop(gen, ins, ">>");
-            break;
         case VSIR_OP_ILT:
         case VSIR_OP_LTO:
         case VSIR_OP_ULT:
@@ -1614,6 +1603,29 @@ static void msl_handle_instruction(struct msl_generator *gen, const struct vsir_
         case VSIR_OP_NEG:
             msl_unary_op(gen, ins, "-");
             break;
+        case VSIR_OP_IREM:
+        case VSIR_OP_UREM:
+            msl_binop(gen, ins, "%");
+            break;
+        case VSIR_OP_ISFINITE:
+            /* Negate to convert from MSL 0/1 bool to vsir 0/-1 bool. */
+            msl_intrinsic(gen, ins, "-isfinite");
+            break;
+        case VSIR_OP_ISHL:
+            msl_binop(gen, ins, "<<");
+            break;
+        case VSIR_OP_ISHR:
+        case VSIR_OP_USHR:
+            msl_binop(gen, ins, ">>");
+            break;
+        case VSIR_OP_ISINF:
+            /* Negate to convert from MSL 0/1 bool to vsir 0/-1 bool. */
+            msl_intrinsic(gen, ins, "-isinf");
+            break;
+        case VSIR_OP_ISNAN:
+            /* Negate to convert from MSL 0/1 bool to vsir 0/-1 bool. */
+            msl_intrinsic(gen, ins, "-isnan");
+            break;
         case VSIR_OP_ITOF:
         case VSIR_OP_UTOF:
             msl_cast(gen, ins, "float");
-- 
