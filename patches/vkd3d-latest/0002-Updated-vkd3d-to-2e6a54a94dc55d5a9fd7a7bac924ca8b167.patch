+        {"InterlockedAnd",             HLSL_INTERLOCKED_AND,      2, 3},
+        {"InterlockedCompareExchange", HLSL_INTERLOCKED_CMP_EXCH, 4, 4},
+        {"InterlockedCompareStore",    HLSL_INTERLOCKED_CMP_EXCH, 3, 3},
+        {"InterlockedExchange",        HLSL_INTERLOCKED_EXCH,     3, 3},
