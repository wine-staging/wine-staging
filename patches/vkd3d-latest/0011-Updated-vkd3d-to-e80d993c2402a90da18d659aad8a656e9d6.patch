From: Alistair Leslie-Hughes <leslie_alistair@hotmail.com>
Date: Thu, 30 Jul 2026 06:51:05 +1000
Subject: [PATCH] Updated vkd3d to e80d993c2402a90da18d659aad8a656e9d6c798b.

---
 libs/vkd3d/include/private/vkd3d_version.h  | 2 +-
 libs/vkd3d/libs/vkd3d-shader/hlsl_codegen.c | 6 +++---
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/libs/vkd3d/include/private/vkd3d_version.h b/libs/vkd3d/include/private/vkd3d_version.h
index bafbdce51a8..e172d75d89a 100644
--- a/libs/vkd3d/include/private/vkd3d_version.h
+++ b/libs/vkd3d/include/private/vkd3d_version.h
@@ -1 +1 @@
-#define VKD3D_VCS_ID " (git 85d79c45)"
+#define VKD3D_VCS_ID " (git e80d993c)"
diff --git a/libs/vkd3d/libs/vkd3d-shader/hlsl_codegen.c b/libs/vkd3d/libs/vkd3d-shader/hlsl_codegen.c
index 25e01ef4a80..4dc98c36564 100644
--- a/libs/vkd3d/libs/vkd3d-shader/hlsl_codegen.c
+++ b/libs/vkd3d/libs/vkd3d-shader/hlsl_codegen.c
@@ -8202,6 +8202,9 @@ static struct vsir_signature_element *generate_signature_entry(struct hlsl_ctx *
                         || (type == VSIR_REGISTER_INPUT && ctx->profile->type == VKD3D_SHADER_TYPE_PIXEL))
                     reg += SM1_COLOR_REGISTER_OFFSET;
             }
+
+            if (type == VSIR_REGISTER_DEPTHOUT)
+                bitmap_set(program->io_dcls, VSIR_REGISTER_DEPTHOUT);
         }
         else if (sm1_usage_from_semantic_name(&version, var->semantic.name,
                 var->semantic.index, output, &usage, &usage_idx))
@@ -8224,9 +8227,6 @@ static struct vsir_signature_element *generate_signature_entry(struct hlsl_ctx *
             return NULL;
         }
 
-        if (type == VSIR_REGISTER_DEPTHOUT)
-            bitmap_set(program->io_dcls, VSIR_REGISTER_DEPTHOUT);
-
         if (builtin && interpolation_mode == VKD3DSIM_LINEAR_CENTROID
                 && (vkd3d_shader_ver_ge(&program->shader_version, 3, 0) || type != VSIR_REGISTER_TEXTURE))
         {
