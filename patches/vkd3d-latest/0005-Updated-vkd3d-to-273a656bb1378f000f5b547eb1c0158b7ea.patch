     {
         .flags = flags,
@@ -2061,7 +2060,7 @@ enum vkd3d_result d3d_asm_compile(struct vsir_program *program, const struct vkd
     enum vkd3d_result result = VKD3D_OK;
     struct vkd3d_string_buffer *buffer;
