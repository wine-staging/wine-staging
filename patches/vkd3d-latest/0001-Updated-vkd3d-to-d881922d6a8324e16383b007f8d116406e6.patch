+    src->o.type = D3DBC_REGISTER_SSA;
+    src->o.index = src_id;
+    src->o.has_rel_addr = false;
+    src->modifiers = VKD3DSPSM_NONE;
+    src->swizzle = VKD3D_SHADER_NO_SWIZZLE;
+}
