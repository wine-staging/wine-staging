From 6682c11c7ec4b58c5dc6a157587ba7f08691516d Mon Sep 17 00:00:00 2001
From: Alistair Leslie-Hughes <leslie_alistair@hotmail.com>
Date: Wed, 23 Sep 2026 06:59:47 +1000
Subject: [PATCH] include: Add missing d3d12 typedefs.

---
 include/d3d12.idl | 36 ++++++++++++++++++++++++++++++++++++
 1 file changed, 36 insertions(+)

diff --git a/include/d3d12.idl b/include/d3d12.idl
index f260743530d..f4f19c9145e 100644
--- a/include/d3d12.idl
+++ b/include/d3d12.idl
@@ -638,6 +638,35 @@ typedef enum D3D12_RAYTRACING_TIER
     D3D12_RAYTRACING_TIER_1_1 = 0xb,
 } D3D12_RAYTRACING_TIER;
 
+typedef enum D3D12_RECREATE_AT_TIER
+{
+    D3D12_RECREATE_AT_TIER_NOT_SUPPORTED    = 0x0,
+    D3D12_RECREATE_AT_TIER_1                = 0x1,
+} D3D12_RECREATE_AT_TIER;
+
+typedef enum D3D12_WORK_GRAPHS_TIER
+{
+    D3D12_WORK_GRAPHS_TIER_NOT_SUPPORTED    = 0x0,
+    D3D12_WORK_GRAPHS_TIER_1_0              = 0xa,
+} D3D12_WORK_GRAPHS_TIER;
+
+typedef enum D3D12_EXECUTE_INDIRECT_TIER
+{
+    D3D12_EXECUTE_INDIRECT_TIER_1_0 = 0xa,
+    D3D12_EXECUTE_INDIRECT_TIER_1_1 = 0xb,
+} D3D12_EXECUTE_INDIRECT_TIER;
+
+typedef enum D3D12_TIGHT_ALIGNMENT_TIER
+{
+    D3D12_TIGHT_ALIGNMENT_TIER_NOT_SUPPORTED    = 0x0,
+    D3D12_TIGHT_ALIGNMENT_TIER_1                = 0x1,
+} D3D12_TIGHT_ALIGNMENT_TIER;
+
+typedef struct D3D12_FEATURE_DATA_TIGHT_ALIGNMENT
+{
+    D3D12_TIGHT_ALIGNMENT_TIER SupportTier;
+} D3D12_FEATURE_DATA_TIGHT_ALIGNMENT;
+
 typedef enum D3D12_RESIDENCY_FLAGS
 {
     D3D12_RESIDENCY_FLAG_NONE = 0x0,
@@ -2521,6 +2550,13 @@ typedef enum D3D12_FEATURE
     D3D12_FEATURE_D3D12_OPTIONS16 = 45,
     D3D12_FEATURE_D3D12_OPTIONS17 = 46,
     D3D12_FEATURE_D3D12_OPTIONS18 = 47,
+    D3D12_FEATURE_D3D12_OPTIONS19 = 48,
+    D3D12_FEATURE_D3D12_OPTIONS20 = 49,
+    D3D12_FEATURE_PREDICATION = 50,
+    D3D12_FEATURE_PLACED_RESOURCE_SUPPORT_INFO = 51,
+    D3D12_FEATURE_HARDWARE_COPY = 52,
+    D3D12_FEATURE_D3D12_OPTIONS21 = 53,
+    D3D12_FEATURE_D3D12_TIGHT_ALIGNMENT = 54,
 } D3D12_FEATURE;
 
 typedef struct D3D12_MEMCPY_DEST
-- 
2.53.0

