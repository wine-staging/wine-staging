-        d[2] = 0x80 | (c & 0x3f);
-        c >>= 6;
-        d[1] = 0x80 | (c & 0x3f);
-        c >>= 6;
-        d[0] = 0xe0 | c;
-        *dst += 3;
-        return;
-    }
