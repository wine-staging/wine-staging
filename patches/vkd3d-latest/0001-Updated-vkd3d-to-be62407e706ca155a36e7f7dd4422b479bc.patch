+    {
+        bool bias = false, negate = false, x2 = false;
+        struct vsir_src_operand *src = &ins->src[i];
+
+        switch (src->modifiers)
+        {
+            case VKD3DSPSM_BIASNEG:
+                bias = true;
+                negate = true;
+                break;
+
+            case VKD3DSPSM_BIAS:
+                bias = true;
+                break;
+
+            case VKD3DSPSM_SIGN:
+                bias = true;
+                x2 = true;
+                break;
+
+            case VKD3DSPSM_SIGNNEG:
+                bias = true;
+                x2 = true;
+                negate = true;
+                break;
+
+            case VKD3DSPSM_X2:
+                x2 = true;
+                break;
+
+            case VKD3DSPSM_X2NEG:
+                x2 = true;
+                negate = true;
+                break;
+
+            case VKD3DSPSM_COMP:
