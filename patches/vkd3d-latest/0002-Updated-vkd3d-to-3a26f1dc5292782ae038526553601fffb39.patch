+static void vsir_src_operand_from_d3dbc(struct vkd3d_shader_sm1_parser *parser, struct vsir_src_operand *vsir,
+        const struct d3dbc_src_operand *d3dbc, const struct d3dbc_src_operand *rel_addr);
