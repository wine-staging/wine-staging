+static float scale_from_shift(struct vkd3d_shader_sm1_parser *parser, unsigned int shift)
+{
+    switch (shift)
+    {
+        case 1: /* _x2 */
+            return 2.0f;
+        case 2: /* _x4 */
+            return 4.0f;
+        case 3: /* _x8 */
+            return 8.0f;
+        case 13: /* _d8 */
+            return 1.0f / 8.0f;
+        case 14: /* _d4 */
+            return 1.0f / 4.0f;
+        case 15: /* _d2 */
+            return 1.0f / 2.0f;
+        default:
+            vkd3d_shader_parser_error(&parser->p, VKD3D_SHADER_ERROR_D3DBC_NOT_IMPLEMENTED,
+                    "Unhandled destination shift %#x.", shift);
+            return 0.0f;
+    }
+}
