     else if (resource->desc.Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE3D)
@@ -4059,7 +4059,7 @@ void d3d12_dsv_desc_create_dsv(struct d3d12_dsv_desc *dsv_desc, struct d3d12_dev
