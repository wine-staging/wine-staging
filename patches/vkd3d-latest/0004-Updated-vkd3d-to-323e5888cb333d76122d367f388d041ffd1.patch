+            FIXME("Unhandled view dimension %s.\n", debug_d3d12_srv_dimension(desc->ViewDimension));
             return;
     }
 
     if (!device->vk_info.EXT_robustness2)
-        WARN("Creating NULL SRV %#x.\n", desc->ViewDimension);
