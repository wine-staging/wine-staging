             {
-                put_u32(buffer, vkd3d_make_u32(D3DXRS_SAMPLER, var->regs[r].index));
+                put_u32(buffer, vkd3d_make_u32(CTAB_REGISTER_SET_SAMPLER, var->regs[r].index));
                 put_u32(buffer, var->bind_count[r]);
             }
             put_u32(buffer, 0); /* type */
diff --git a/libs/vkd3d/libs/vkd3d-shader/tpf.c b/libs/vkd3d/libs/vkd3d-shader/tpf.c
index c729f0e68cd..17d230b2e30 100644
--- a/libs/vkd3d/libs/vkd3d-shader/tpf.c
+++ b/libs/vkd3d/libs/vkd3d-shader/tpf.c
@@ -964,13 +964,26 @@ static void shader_sm4_read_dcl_index_range(struct vsir_instruction *ins, uint32
     struct vkd3d_shader_index_range *index_range = &ins->declaration.index_range;
     struct vsir_program *program = priv->program;
     unsigned int i, register_idx, register_count;
+    const uint32_t *end = &tokens[token_count];
     const struct vsir_signature *signature;
     struct sm4_index_range_array *ranges;
     enum vsir_register_type type;
     unsigned int *io_masks;
     uint32_t write_mask;
 
-    tpf_read_dst_operand(priv, &tokens, &tokens[token_count], VSIR_DATA_OPAQUE, &index_range->dst);
+    if (!tpf_read_dst_operand(priv, &tokens, end, VSIR_DATA_OPAQUE, &index_range->dst))
+    {
+        ins->opcode = VSIR_OP_INVALID;
+        return;
+    }
+
+    if (tokens >= end)
+    {
+        WARN("Invalid ptr %p >= end %p.\n", tokens, end);
+        ins->opcode = VSIR_OP_INVALID;
+        return;
+    }
+
     index_range->register_count = *tokens;
 
     register_idx = index_range->dst.reg.idx[index_range->dst.reg.idx_count - 1].offset;
@@ -1018,6 +1031,15 @@ static void shader_sm4_read_dcl_index_range(struct vsir_instruction *ins, uint32
             return;
     }
 
+    /* register_idx < MAX_REG_OUTPUT was already validated when reading the
+     * destination operand. */
+    if (register_count > MAX_REG_OUTPUT - register_idx)
+    {
+        vkd3d_shader_parser_error(&priv->p, VKD3D_SHADER_ERROR_TPF_INVALID_INDEX_RANGE_DCL,
+                "Invalid register index range base %u, count %u.", register_idx, register_count);
+        return;
+    }
+
     for (i = 0; i < ranges->count; ++i)
     {
         struct sm4_index_range r = ranges->ranges[i];
@@ -1037,6 +1059,14 @@ static void shader_sm4_read_dcl_index_range(struct vsir_instruction *ins, uint32
             return;
         }
     }
+
+    if (ranges->count >= ARRAY_SIZE(ranges->ranges))
+    {
+        vkd3d_shader_parser_error(&priv->p, VKD3D_SHADER_ERROR_TPF_INVALID_INDEX_RANGE_DCL,
+                "Unable to handle more than %zu dcl_index_range instructions.", ARRAY_SIZE(ranges->ranges));
+        return;
+    }
+
     ranges->ranges[ranges->count].index = register_idx;
     ranges->ranges[ranges->count].count = register_count;
     ranges->ranges[ranges->count++].mask = write_mask;
diff --git a/libs/vkd3d/libs/vkd3d-shader/vkd3d_shader_private.h b/libs/vkd3d/libs/vkd3d-shader/vkd3d_shader_private.h
