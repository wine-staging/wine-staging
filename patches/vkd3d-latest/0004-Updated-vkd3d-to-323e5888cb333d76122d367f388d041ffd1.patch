                 vkd3d_texture_view_desc_normalise(&vkd3d_desc, &resource->desc);
                 break;
             default:
-                FIXME("Unhandled view dimension %#x.\n", desc->ViewDimension);
+                FIXME("Unhandled view dimension %s.\n", debug_d3d12_srv_dimension(desc->ViewDimension));
         }
