+            vkd3d_string_buffer_printf(buffer, "%s_in_%u[%u]", gen->prefix, i, j);
+            shader_glsl_print_write_mask(buffer, e->mask);
+            if (e->sysval_semantic == VKD3D_SHADER_SV_NONE)
             {
