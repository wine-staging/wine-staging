+import "d3d10shader.idl";
+
+[
+    uuid(c3457783-a846-47ce-9520-cea6f66e7447),
+    object,
+    local,
+]
+interface ID3D10ShaderReflection1 : IUnknown
+{
+    HRESULT GetDesc(D3D10_SHADER_DESC *desc);
+    ID3D10ShaderReflectionConstantBuffer *GetConstantBufferByIndex(UINT index);
+    ID3D10ShaderReflectionConstantBuffer *GetConstantBufferByName(const char *name);
+    HRESULT GetResourceBindingDesc(UINT index, D3D10_SHADER_INPUT_BIND_DESC *desc);
+    HRESULT GetInputParameterDesc(UINT index, D3D10_SIGNATURE_PARAMETER_DESC *desc);
+    HRESULT GetOutputParameterDesc(UINT index, D3D10_SIGNATURE_PARAMETER_DESC *desc);
+    ID3D10ShaderReflectionVariable *GetVariableByName(const char *name);
+    HRESULT GetResourceBindingDescByName(const char *name, D3D10_SHADER_INPUT_BIND_DESC *desc);
+    HRESULT GetMovInstructionCount(UINT *count);
+    HRESULT GetMovcInstructionCount(UINT *count);
+    HRESULT GetConversionInstructionCount(UINT *count);
+    HRESULT GetBitwiseInstructionCount(UINT *count);
+    HRESULT GetGSInputPrimitive(D3D_PRIMITIVE *primitive);
+    HRESULT IsLevel9Shader(BOOL *level9_shader);
+    HRESULT IsSampleFrequencyShader(BOOL *sample_frequency);
+}
