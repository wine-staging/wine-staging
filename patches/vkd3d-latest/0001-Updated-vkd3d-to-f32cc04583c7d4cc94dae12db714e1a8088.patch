     }
 }
 
+static void check_invalid_globallycoherent(struct hlsl_ctx *ctx, const struct hlsl_type *type,
+        const struct vkd3d_shader_location *loc)
+{
+    if (type->class == HLSL_CLASS_ARRAY)
+    {
+        check_invalid_globallycoherent(ctx, type->e.array.type, loc);
+    }
+    else if (type->class == HLSL_CLASS_STRUCT)
+    {
+        for (unsigned int i = 0; i < type->e.record.field_count; ++i)
+            check_invalid_globallycoherent(ctx, type->e.record.fields[i].type, loc);
+    }
+    else if (type->class != HLSL_CLASS_UAV && (type->modifiers & HLSL_MODIFIER_GLOBALLYCOHERENT))
+    {
+        hlsl_error(ctx, loc, VKD3D_SHADER_ERROR_HLSL_INVALID_MODIFIER,
+                "globallycoherent can only be used with UAVs.");
+    }
+}
+
 static void declare_var(struct hlsl_ctx *ctx, struct parse_variable_def *v)
 {
     bool nonlocal = ctx->cur_scope == ctx->globals || ctx->cur_scope->namespace;
@@ -2729,6 +2751,9 @@ static void declare_var(struct hlsl_ctx *ctx, struct parse_variable_def *v)
             hlsl_error(ctx, &var->loc, VKD3D_SHADER_ERROR_HLSL_MISPLACED_STREAM_OUTPUT,
                     "Stream output object '%s' is not allowed in the global scope.", var->name);
 
+        if (!(modifiers & HLSL_STORAGE_STATIC))
+            check_invalid_globallycoherent(ctx, basic_type, &var->loc);
+
         if ((ctx->profile->major_version < 5 || ctx->profile->type == VKD3D_SHADER_TYPE_EFFECT)
                 && (var->storage_modifiers & HLSL_STORAGE_UNIFORM))
         {
@@ -4325,6 +4350,16 @@ static bool intrinsic_isinf(struct hlsl_ctx *ctx,
     return !!add_expr(ctx, params->instrs, HLSL_OP1_ISINF, args, bool_type, loc);
 }
 
+static bool intrinsic_isnan(struct hlsl_ctx *ctx,
+        const struct parse_initializer *params, const struct vkd3d_shader_location *loc)
+{
+    struct hlsl_type *bool_type = hlsl_change_base_type(ctx, params->args[0]->data_type, HLSL_TYPE_BOOL);
+    struct hlsl_ir_node *args[HLSL_MAX_OPERANDS] = {0};
+
+    args[0] = params->args[0];
+    return !!add_expr(ctx, params->instrs, HLSL_OP1_ISNAN, args, bool_type, loc);
+}
+
 static bool intrinsic_ldexp(struct hlsl_ctx *ctx,
         const struct parse_initializer *params, const struct vkd3d_shader_location *loc)
 {
@@ -5290,12 +5325,47 @@ static bool intrinsic_GetRenderTargetSampleCount(struct hlsl_ctx *ctx,
     return true;
 }
 
+static struct hlsl_type *get_interlocked_exchange_type(struct hlsl_ctx *ctx, const struct hlsl_type *type)
+{
+    if (!type->is_minimum_precision
+            && (type->e.numeric.type == HLSL_TYPE_INT || type->e.numeric.type == HLSL_TYPE_UINT))
+        return hlsl_get_scalar_type(ctx, type->e.numeric.type);
+
+    return hlsl_get_scalar_type(ctx, HLSL_TYPE_FLOAT);
+}
+
+static void check_interlocked_dst_type(struct hlsl_ctx *ctx, const char *name, const struct hlsl_type *type,
+        enum hlsl_interlocked_op op, const struct vkd3d_shader_location *loc)
+{
+    struct vkd3d_string_buffer *string;
+
+    if (type->class == HLSL_CLASS_SCALAR && !type->is_minimum_precision)
+    {
+        if (type->e.numeric.type == HLSL_TYPE_INT || type->e.numeric.type == HLSL_TYPE_UINT)
+            return;
+
+        /* InterlockedExchange() also allows float/half destinations,
+         * but not double destinations. */
+        if (op == HLSL_INTERLOCKED_EXCH
+                && (type->e.numeric.type == HLSL_TYPE_FLOAT || type->e.numeric.type == HLSL_TYPE_HALF))
+            return;
+    }
+
+    if ((string = hlsl_type_to_string(ctx, type)))
+    {
+        hlsl_error(ctx, loc, VKD3D_SHADER_ERROR_HLSL_INVALID_TYPE,
+                "Unexpected type for argument 0 of '%s': expected %s, but got '%s'.", name,
+                op == HLSL_INTERLOCKED_EXCH ? "'uint', 'int', 'float', or 'half'" : "'uint' or 'int'",
+                string->buffer);
+        hlsl_release_string_buffer(ctx, string);
+    }
+}
+
 static bool intrinsic_interlocked(struct hlsl_ctx *ctx, enum hlsl_interlocked_op op,
         const struct parse_initializer *params, const struct vkd3d_shader_location *loc, const char *name)
 {
     struct hlsl_ir_node *interlocked, *lhs, *val, *cmp_val = NULL, *orig_val = NULL;
     struct hlsl_type *lhs_type, *val_type, *ret_type = NULL;
-    struct vkd3d_string_buffer *string;
     unsigned int writemask, component;
     struct hlsl_deref dst_deref;
     bool matrix_writemask;
@@ -5316,6 +5386,8 @@ static bool intrinsic_interlocked(struct hlsl_ctx *ctx, enum hlsl_interlocked_op
     lhs = params->args[0];
     lhs_type = lhs->data_type;
 
+    check_interlocked_dst_type(ctx, name, lhs_type, op, loc);
+
     if (op == HLSL_INTERLOCKED_CMP_EXCH)
     {
         cmp_val = params->args[1];
@@ -5331,34 +5403,35 @@ static bool intrinsic_interlocked(struct hlsl_ctx *ctx, enum hlsl_interlocked_op
     }
 
     if (orig_val)
-        ret_type = lhs_type;
-
-    if (lhs_type->class != HLSL_CLASS_SCALAR || (lhs_type->e.numeric.type != HLSL_TYPE_UINT
-            && lhs_type->e.numeric.type != HLSL_TYPE_INT))
     {
-        if ((string = hlsl_type_to_string(ctx, lhs_type)))
-        {
-            hlsl_error(ctx, loc, VKD3D_SHADER_ERROR_HLSL_INVALID_TYPE,
-                    "Unexpected type for argument 0 of '%s': expected 'uint' or 'int', but got '%s'.",
-                    name, string->buffer);
-            hlsl_release_string_buffer(ctx, string);
-        }
-        return false;
+        /* Other than InterlockedExchange(), the original value is returned as int. */
+        if (op == HLSL_INTERLOCKED_EXCH)
+            ret_type = get_interlocked_exchange_type(ctx, orig_val->data_type);
+        else
+            ret_type = hlsl_get_scalar_type(ctx, HLSL_TYPE_INT);
     }
 
     /* Interlocked*() functions always take uint for the value parameters,
      * except for InterlockedMax()/InterlockedMin(). */
-    if (op == HLSL_INTERLOCKED_MAX || op == HLSL_INTERLOCKED_MIN)
+    if (op == HLSL_INTERLOCKED_UMAX || op == HLSL_INTERLOCKED_UMIN)
     {
-        enum hlsl_base_type val_base_type = val->data_type->e.numeric.type;
-
-        /* Floating values are always cast to signed integers. */
-        if (val_base_type == HLSL_TYPE_FLOAT || val_base_type == HLSL_TYPE_HALF || val_base_type == HLSL_TYPE_DOUBLE)
-            val_type = hlsl_get_scalar_type(ctx, HLSL_TYPE_INT);
-        else if (val_base_type != lhs_type->e.numeric.type)
+        if (val->data_type->e.numeric.type == HLSL_TYPE_UINT)
+        {
             val_type = hlsl_get_scalar_type(ctx, HLSL_TYPE_UINT);
+        }
         else
-            val_type = hlsl_get_scalar_type(ctx, val_base_type);
+        {
+            /* For InterlockedMax/Min, values other than uint are always cast to
+             * int first, but the interlocked operation itself is signed only if
+             * the destination type is int as well. */
+            val_type = hlsl_get_scalar_type(ctx, HLSL_TYPE_INT);
+            if (lhs_type->e.numeric.type == HLSL_TYPE_INT)
+                op = op == HLSL_INTERLOCKED_UMAX ? HLSL_INTERLOCKED_IMAX : HLSL_INTERLOCKED_IMIN;
+        }
+    }
+    else if (op == HLSL_INTERLOCKED_EXCH)
+    {
+        val_type = get_interlocked_exchange_type(ctx, val->data_type);
     }
     else
     {
@@ -5375,8 +5448,6 @@ static bool intrinsic_interlocked(struct hlsl_ctx *ctx, enum hlsl_interlocked_op
         return false;
 
     VKD3D_ASSERT(writemask);
-    /* The writemask should be single component. */
-    VKD3D_ASSERT(!(writemask & (writemask - 1)));
 
     component = vkd3d_log2i(writemask);
     if (matrix_writemask)
@@ -5466,13 +5537,13 @@ static bool intrinsic_InterlockedExchange(struct hlsl_ctx *ctx,
 static bool intrinsic_InterlockedMax(struct hlsl_ctx *ctx,
         const struct parse_initializer *params, const struct vkd3d_shader_location *loc)
 {
-    return intrinsic_interlocked(ctx, HLSL_INTERLOCKED_MAX, params, loc, "InterlockedMax");
+    return intrinsic_interlocked(ctx, HLSL_INTERLOCKED_UMAX, params, loc, "InterlockedMax");
 }
 
 static bool intrinsic_InterlockedMin(struct hlsl_ctx *ctx,
         const struct parse_initializer *params, const struct vkd3d_shader_location *loc)
 {
-    return intrinsic_interlocked(ctx, HLSL_INTERLOCKED_MIN, params, loc, "InterlockedMin");
+    return intrinsic_interlocked(ctx, HLSL_INTERLOCKED_UMIN, params, loc, "InterlockedMin");
 }
 
 static bool intrinsic_InterlockedOr(struct hlsl_ctx *ctx,
@@ -5713,6 +5784,7 @@ intrinsic_functions[] =
     {"fwidth",                              1, true,  intrinsic_fwidth},
     {"isfinite",                            1, true,  intrinsic_isfinite},
     {"isinf",                               1, true,  intrinsic_isinf},
+    {"isnan",                               1, true,  intrinsic_isnan},
     {"ldexp",                               2, true,  intrinsic_ldexp},
     {"length",                              1, true,  intrinsic_length},
     {"lerp",                                3, true,  intrinsic_lerp},
@@ -9431,6 +9503,8 @@ var_modifiers:
                 $$ = add_modifiers(ctx, $2, HLSL_MODIFIER_PRECISE, &@1);
             else if (!strcmp($1, "single"))
                 $$ = add_modifiers(ctx, $2, HLSL_MODIFIER_SINGLE, &@1);
+            else if (!strcmp($1, "globallycoherent"))
+                $$ = add_modifiers(ctx, $2, HLSL_MODIFIER_GLOBALLYCOHERENT, &@1);
             else
                 hlsl_error(ctx, &@1, VKD3D_SHADER_ERROR_HLSL_UNKNOWN_MODIFIER,
                         "Unknown modifier %s.", debugstr_a($1));
