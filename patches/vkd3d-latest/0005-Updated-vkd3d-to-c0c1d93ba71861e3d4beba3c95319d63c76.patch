-int vkd3d_string_buffer_print_f16(struct vkd3d_string_buffer *buffer, uint16_t f)
-{
-    size_t idx = buffer->content_size + 1;
-    union
-    {
-        uint32_t u32;
-        float f32;
-    } v;
-    int ret;
