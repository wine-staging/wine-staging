+/* check if a config was previously imported */
+static BOOL has_config_marker( const WCHAR *config_dir )
+{
+    WCHAR *path;
+    BOOL found;
+
+    path = malloc( (wcslen(config_dir) + wcslen(L"\\.config-imported") + 1) * sizeof(WCHAR) );
+    if (!path) return FALSE;
+    wcscpy( path, config_dir );
+    wcscat( path, L"\\.config-imported" );
+    found = (_waccess( path, 0 ) == 0);
+    free( path );
+    return found;
+}
+
+/* write the config import marker */
+static void write_config_marker( const WCHAR *config_dir )
+{
+    WCHAR *path;
+    FILE *f;
+
+    path = malloc( (wcslen(config_dir) + wcslen(L"\\.config-imported") + 1) * sizeof(WCHAR) );
+    if (!path) return;
+    wcscpy( path, config_dir );
+    wcscat( path, L"\\.config-imported" );
+    f = _wfopen( path, L"w" );
+    if (f) fclose( f );
+    free( path );
+}
+
+/* import ~/.config/wine/config.reg into the prefix if present */
+static void import_user_config(void)
+{
+    const WCHAR *ignore_env;
+    const WCHAR *config_dir;
+    const WCHAR *home_dir;
+    WCHAR *config_path;
+    WCHAR unix_home[MAX_PATH];
+    WCHAR *p;
+    DWORD len;
+
+    ignore_env = _wgetenv( L"WINE_IGNORE_CONFIG" );
+    if (ignore_env && !wcscmp( ignore_env, L"1" ))
+        return;
+
+    config_dir = _wgetenv( L"WINECONFIGDIR" );
+    if (!config_dir) return;
+
+    /* if a config was already imported, just warn and return */
+    if (has_config_marker( config_dir ))
+    {
+        WINE_MESSAGE( "wine: A config was imported to this prefix. Please use a fresh prefix when reporting bugs.\n" );
+        return;
+    }
+
+    home_dir = _wgetenv( L"WINEHOMEDIR" );
+    if (!home_dir) return;
+
+    /* convert NT path to unix path, same as prettyprint_configdir */
+    lstrcpynW( unix_home, home_dir, ARRAY_SIZE(unix_home) );
+    if (!wcsncmp( unix_home, L"\\??\\unix\\", 9 ))
+    {
+        p = unix_home + 9;
+        for (; *p; p++) if (*p == '\\') *p = '/';
+        p = unix_home + 9;
+    }
+    else if (!wcsncmp( unix_home, L"\\??\\Z:\\", 7 ))
+    {
+        p = unix_home + 6;
+        for (; *p; p++) if (*p == '\\') *p = '/';
+        p = unix_home + 6;
+    }
+    else return;
+
+    /* build path to ~/.config/wine/config.reg */
+    len = wcslen( p ) + wcslen( L"/.config/wine/config.reg" ) + 1;
+    config_path = malloc( len * sizeof(WCHAR) );
+    if (!config_path) return;
+    wcscpy( config_path, p );
+    wcscat( config_path, L"/.config/wine/config.reg" );
+
+    /* check if the file exists */
+    if (_waccess( config_path, 0 ) == -1)
+    {
+        free( config_path );
+        return;
+    }
+
+    WINE_MESSAGE( "wine: importing user config from %s\n", wine_dbgstr_w(config_path) );
+
+    /* run reg.exe import silently */
+    {
+        WCHAR *reg_path;
+        WCHAR *cmdline;
+        WCHAR sysdir[MAX_PATH];
+        PROCESS_INFORMATION pi;
+        STARTUPINFOW si;
+
+        GetSystemDirectoryW( sysdir, MAX_PATH );
+        len = wcslen( sysdir ) + wcslen( L"\\reg.exe" ) + 1;
+        reg_path = malloc( len * sizeof(WCHAR) );
+        if (!reg_path) { free( config_path ); return; }
+        wcscpy( reg_path, sysdir );
+        wcscat( reg_path, L"\\reg.exe" );
+
+        len = wcslen( reg_path ) + 8 + wcslen( config_path ) + 1;
+        cmdline = malloc( len * sizeof(WCHAR) );
+        if (!cmdline) { free( reg_path ); free( config_path ); return; }
+        wsprintfW( cmdline, L"\"%s\" import %s", reg_path, config_path );
+
+        free( config_path );
+
+        memset( &si, 0, sizeof(si) );
+        si.cb = sizeof(si);
+        memset( &pi, 0, sizeof(pi) );
+
+        if (CreateProcessW( reg_path, cmdline, NULL, NULL, FALSE, CREATE_NO_WINDOW, NULL, NULL, &si, &pi ))
+        {
+            WaitForSingleObject( pi.hProcess, INFINITE );
+            CloseHandle( pi.hProcess );
+            CloseHandle( pi.hThread );
+            write_config_marker( config_dir );
+            SendMessageTimeoutW( HWND_BROADCAST, WM_SETTINGCHANGE, 0, (LPARAM)L"windows", SMTO_ABORTIFHUNG, 5000, NULL );
+            WINE_MESSAGE( "wine: A config was imported to this prefix. Please use a fresh prefix when reporting bugs.\n" );
+        }
+        else WINE_ERR( "wine: failed to run reg for config import, err %ld\n", GetLastError() );
+
+        free( cmdline );
+        free( reg_path );
+    }
+}
